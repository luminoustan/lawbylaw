# Copy to .env (never commit .env). Secrets come from env / secret store only.
# Free shared provider: Nebius Token Factory. When NEBIUS_API_KEY is set the server uses only
# the NEBIUS_* values. DEEPSEEK_* is a legacy fallback, used only when no Nebius key is set.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-flash

# Web search tools offered to the agent. Nebius has no search API, so Tavily is the only
# search tool on the free key; leave empty to offer none.
TAVILY_API_KEY=

# Qdrant / embeddings (optional; chat degrades gracefully without them)
QDRANT_HOST=qdrant
QDRANT_PORT=6334
VLLM_BASE_URL=http://embedder:8000
# Collections (defaults shown). Judgments back the research_judiciary sub-agent.
QDRANT_ACT_COLLECTION=act_chunked
QDRANT_SL_COLLECTION=sl_chunked
QDRANT_JUDICIARY_COLLECTION=judiciary_chunked

# Where to find the real client IP: none | cf | xff
# "none" uses the socket address and ignores spoofable headers.
TRUST_PROXY=none

# Limits (defaults shown)
LIMIT_BODY_BYTES=1048576
LIMIT_MESSAGE_CHARS=200000
LIMIT_MAX_MESSAGES=200
# 200k-token model window. Nothing summarises a chat on its own: past CONTEXT_TOKENS the oldest
# turns are dropped (users shorten a chat earlier with /compact).
LIMIT_MODEL_WINDOW=200000
LIMIT_CONTEXT_TOKENS=140000
LIMIT_SUMMARY_CHARS=16000
# Verification reminder on tool results, and one
# "check your draft" pass after the answer is written (1=on, 0=off). Off by default:
# the agent finishes when the answer is done instead of working on after it.
LIMIT_TOOL_NUDGE=1
LIMIT_FINAL_CHECK=0
LIMIT_RATE_PER_MIN=8
LIMIT_RATE_BURST=4
LIMIT_IP_CONCURRENCY=1
LIMIT_GLOBAL_CONCURRENCY=50
LIMIT_REPEAT_MAX=3
LIMIT_REPEAT_WINDOW_S=60
LIMIT_DAILY_TOKEN_BUDGET=5000000
LIMIT_TOOL_ROUNDS=10
LIMIT_REQUEST_TIMEOUT_S=180
# POST /api/tool (stateless tool calls for browsers that bring their own LLM key):
# per-IP token bucket and in-flight caps, plus a global in-flight cap. A tool call holds its
# slot for milliseconds, so the global cap is high on purpose: measured with 300 honest users
# plus 60 abusive IPs, 200 left honest users served 19-48% of the time, 500 left 93-99%, and
# 1000 left 100% (peak memory about 104, 144 and 194 MB). Lower it to protect a weak database.
LIMIT_TOOL_RATE_PER_MIN=240
LIMIT_TOOL_BURST=60
LIMIT_TOOL_IP_CONCURRENCY=12
LIMIT_TOOL_GLOBAL_CONCURRENCY=500
# Gatekeeper: a small LLM call screens each user message (greetings, off-topic,
# prompt injection) before the main agent runs. Blocked messages get a canned reply.
# If the gatekeeper call fails the request is rejected (fail closed).
GATEKEEPER_ENABLED=true
# Empty = use NEBIUS_MODEL
GATEKEEPER_MODEL=
GATEKEEPER_TIMEOUT_S=8
# Cloudflare Turnstile session gate. Off unless TURNSTILE_ENFORCE is true; then every chat,
# tool, citation and agent request needs the signed x-lbl-session header. SESSION_HMAC_KEY must
# be identical on every replica (random, 32+ bytes) or sessions break across restarts.
TURNSTILE_ENFORCE=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
SESSION_HMAC_KEY=
SESSION_TTL_S=1800
# Optional runtime data (see server/data/README.md); relative to the server's cwd.
TOKENIZER_PATH=data/qwen3_tokenizer.json
SELFHELP_GUIDE_PATH=data/selfhelp_guide.md
SSO_ACT_INDEX_PATH=data/sso_act_index.json
PORT=8000
